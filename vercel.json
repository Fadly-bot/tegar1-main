{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 10
    }
  },
  "redirects": [
    { "source": "/", "destination": "/api/home.php", "statusCode": 307 },
    { "source": "/index.php", "destination": "/api/home.php", "statusCode": 307 }
  ],
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/public/assets/$1" },
    { "source": "/icons/(.*)", "destination": "/public/icons/$1" },
    { "source": "/manifest.webmanifest", "destination": "/public/manifest.webmanifest" },
    { "source": "/sw.js", "destination": "/public/sw.js" },
    { "source": "/((?!api/|assets/).*)", "destination": "/api/home.php" }
  ]
}
